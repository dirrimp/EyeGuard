#!/bin/sh /etc/rc.common
# Second instance of the phone connector, for Jada's phone (2026-10-01).
# Same script as the primary; only the config differs. START is after the
# primary's 95 so the primary always comes up first.
START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/eyeguard-phone.py --conf /etc/eyeguard/phone-jada.json
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
