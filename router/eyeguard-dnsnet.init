#!/bin/sh /etc/rc.common
# Router-only network monitor: every DNS query on every segment + bypass
# (Tor / VPN / DoT / DoH / Private Relay) detection. Same config file as the
# phone monitor. START is after both phone instances (95, 96).
START=97
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/eyeguard-dnsnet.py
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

