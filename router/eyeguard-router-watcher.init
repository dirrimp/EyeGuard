#!/bin/sh /etc/rc.common
# Router integrity/liveness watcher -- admin-trust pivot (2026-08-24). A
# SEPARATE service from eyeguard-phone, on purpose: see
# router/eyeguard-router-watcher.py's module docstring for why a check
# running inside the process being checked can be disabled by the same
# edit that disables everything else.
START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/eyeguard-router-watcher.py
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
