{
  "_comment": "Copy to /etc/eyeguard/phone.json and fill in the CAPS values.",

  "supabase_url": "https://ucgldleacehxjjwwqomk.supabase.co",
  "secret_file": "/etc/eyeguard/.supabase_secret",

  "_home": "The phone's LAN identity when on home wifi. Set a Reserved IP for it in the router's Clients page first, and turn OFF Private Wi-Fi Address on the phone for this network -- otherwise the IP/MAC drift and capture silently stops matching.",
  "home_ip": "192.168.8.153",
  "home_interface": "br-lan",

  "_wg": "The phone's identity on the WireGuard tunnel (away from home). Also the sleep-aware liveness signal: set Persistent Keepalive = 25 on the phone's peer (router GUI) so a sleeping-but-connected phone still reads alive; only a truly-down tunnel goes dark. Find the interface name with `wg show` on the router (often NOT wg0 -- GL.iNet's Flint 2 names it e.g. wgserver).",
  "wg_interface": "wgserver",
  "wg_ip": "10.1.0.2",
  "wg_peer": "PHONE_WIREGUARD_PUBLIC_KEY",

  "dark_buffer_seconds": 60,
  "green_repeat_seconds": 900,
  "heartbeat_seconds": 20,

  "_terms": "Reuse the Mac's text.terms watchlist -- an explicit domain = red.",
  "explicit_terms": ["porn","pornhub","xvideos","xhamster","xnxx","redtube",
    "youporn","brazzers","onlyfans","chaturbate","spankbang","xxx","nude",
    "naked","hentai","rule34","camgirl","escort","fetish"],

  "_noise": "DNS noise to DROP so the green trail is browsing, not telemetry. Add to this as junk leaks through. .arpa, .local, .lan, and .invalid are always dropped regardless (reverse-DNS / mDNS / iOS captive-portal-probe junk).",
  "noise_domains": ["googleapis.com","gstatic.com","google-analytics.com",
    "googletagmanager.com","doubleclick.net","googlesyndication.com",
    "googleusercontent.com","cloudfront.net","akamai.net","akamaized.net",
    "akamaiedge.net","akadns.net","fbcdn.net","cdninstagram.com",
    "apple.com","apple-dns.net","icloud.com","icloud-content.com",
    "mzstatic.com","aaplimg.com","push.apple.com",
    "fastly.net","fastly-edge.com","hostinger.com",
    "crashlytics.com","sentry.io","amplitude.com","segment.io","branch.io",
    "cloudflare.com","cloudflareinsights.com","gvt1.com","gvt2.com","1e100.net",
    "digicert.com","ocsp","gpsdev","in-app","appsflyer","adjust.com",
    "t-mobile.com","planningcenteronline.com"],

  "_app_map": "Collapse service domains to a readable app name in the feed.",
