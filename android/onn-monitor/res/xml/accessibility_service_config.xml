<?xml version="1.0" encoding="utf-8"?>
<!-- Screenshots (canTakeScreenshot). canRetrieveWindowContent stays FALSE: only the text that Android attaches to events from
     the allowlisted media apps is counted (phase 5a, facts only). No key events, no gestures. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canTakeScreenshot="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="500"
    android:description="@string/service_description" />
